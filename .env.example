# Aervy Web App Environment Variables Template
# Copy this file to .env.local for local development. Never commit real secrets.

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aervy?schema=public"

# Authentication (NextAuth / Auth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-byte-hex-string"

# Payments (Razorpay Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Object Storage (S3-compatible: AWS S3, MinIO, Cloudflare R2)
S3_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
S3_REGION="ap-south-1"
S3_BUCKET="aervy-creative-assets-dev"
S3_ACCESS_KEY_ID="placeholder_access_key"
S3_SECRET_ACCESS_KEY="placeholder_secret_key"
